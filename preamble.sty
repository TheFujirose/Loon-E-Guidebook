%---------------- Custom Commands ----------------%

% Command to create a title page
% Usage: \asvtitle[<date>]{<title>}{<version>}
% - <date> is optional and defaults to today's date
% - <title> is the main title of the document
% - <version> is the version number of the document
% Version 1.0.0
\newcommand{\asvtitle}[3][\today]{%
    \begin{center} % Centered title page
        \includegraphics[width=2in]{./images/logo.png}\\[0.5cm]
        {\Large \textbf{#2}}\\[0.2cm]
        \textit{Humber Polytechnic}\\[0.5cm]
        {\small \textbf{Version #3}}\\
        {\small \textbf{Date:} #1}\\
    \end{center}
    \newpage
}

% Command to start the appendix section
% Usage: \startappendix
% This command will start the appendix section, using letters for section numbering and starting each section on a new page.
% Version 1.0.0
\newcommand{\startappendix}{%
    \appendix % Start the appendix section
    \renewcommand{\thesection}{\Alph{section}} % Use letters for section numbering in the appendix
    \titleformat{\section}{\large\bfseries}{\thesection}{0.5em}{} % Customize section titles and start each section on a new page
}

% Command to start the table of contents, list of figures, and list of tables
% Usage: \startcontents
% This command will generate the table of contents, list of figures, and list of tables, each starting on a new page.
% Version 1.0.0
\newcommand{\startcontents}{%
    \tableofcontents
    \newpage
    \listoffigures
    \newpage
    \listoftables
    \newpage
}

% Command to make a large warning box for important notes
% Usage: \warningbox{<warning message>}
% This command will create a large warning box with the specified warning message, making it visually distinct
% Version 1.1.0
\newcommand{\warningbox}[2][]{%
    \begin{center}
    \fbox{%
        \parbox{0.95\linewidth}{%
            \centering
            \textbf{\Large WARNING}\\[0.5em]
            #2 \\ % Required argument for the warning message
            #1 % Optional argument for the warning message
        }%
    }
    \end{center}
}

%---------------- Meta ----------------%
% This is here because of Content having section titles
\titleformat{\section}{\large\bfseries}{\thesection}{0.5em}{} % Customize section titles and start each section on a new page
\titleformat{\subsection}{\normalsize\bfseries}{\ }{0pt}{} % Customize subsection titles